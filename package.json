{
  "name": "git-sorry",
  "version": "1.2.1",
  "description": "Your git blame, now with feelings. Run it in any repo with no setup and it finds your worst line, names the culprit and reads out the verdict.",
  "author": "Xianying",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuhairadnansutrisno2502-lab/git-sorry.git"
  },
  "homepage": "https://github.com/zuhairadnansutrisno2502-lab/git-sorry#readme",
  "bugs": "https://github.com/zuhairadnansutrisno2502-lab/git-sorry/issues",
  "type": "module",
  "bin": {
    "git-sorry": "dist/index.js"
  },
  "files": [
    "dist",
    "lines.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "git",
    "blame",
    "git-blame",
    "cli",
    "command-line",
    "developer-tools",
    "ai",
    "llm",
    "gemini",
    "google-gemini",
    "webhook",
    "slack",
    "discord",
    "chatops",
    "roast",
    "humor",
    "fun"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.0.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
